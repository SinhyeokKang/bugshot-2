# CI e2e 전용 더미 env. 워크플로가 `cp .env.ci .env.local`로 로드한다
# (Vite의 loadEnv는 .env/.env.local/.env.[mode]만 읽어 .env.ci를 자동으로 집지 않는다).
#
# 값은 전부 가짜다. e2e는 실제 OAuth 왕복을 하지 않고(계정은 chrome.storage에 직접 주입),
# 필요한 건 isConfigured()의 "설정됨" 판정뿐이다 — 비어 있으면 연동 탭 OAuth 버튼이
# 숨겨져 로컬(.env.local에 실값)과 CI의 UI가 갈린다. 그걸 막는 게 이 파일의 전부다.
# PostHog 키는 비워 둔다 — CI 실행이 익명 집계를 오염시키면 안 된다(빈 값 = no-op).

VITE_ATLASSIAN_CLIENT_ID=e2e-dummy-atlassian
VITE_GITHUB_CLIENT_ID=e2e-dummy-github
VITE_LINEAR_CLIENT_ID=e2e-dummy-linear
VITE_NOTION_CLIENT_ID=e2e-dummy-notion
VITE_GITLAB_CLIENT_ID=e2e-dummy-gitlab
VITE_ASANA_CLIENT_ID=e2e-dummy-asana
VITE_CLICKUP_CLIENT_ID=e2e-dummy-clickup
VITE_SLACK_CLIENT_ID=e2e-dummy-slack

# store 빌드 전용 — e2e 빌드는 승격 경로를 타지 않으므로 빈 값.
VITE_GITHUB_CLIENT_ID_PROD=

VITE_OAUTH_PROXY_URL=https://e2e.invalid

# 집계 no-op 유지 — 값을 넣지 말 것.
VITE_POSTHOG_KEY=
VITE_POSTHOG_KEY_PROD=
VITE_POSTHOG_HOST=
