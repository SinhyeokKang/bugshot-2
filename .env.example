# cp .env.example .env.local
#
# All keys are optional. A missing OAuth client ID just hides that platform's
# OAuth button (token auth still works); a missing PostHog key disables analytics.
# BugShot builds and runs fine with this file left empty.

# OAuth client IDs — register your own app per platform,
# redirect URI: https://<extension-id>.chromiumapp.org/
VITE_ATLASSIAN_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_LINEAR_CLIENT_ID=
VITE_NOTION_CLIENT_ID=
VITE_GITLAB_CLIENT_ID=
VITE_ASANA_CLIENT_ID=
VITE_CLICKUP_CLIENT_ID=
VITE_SLACK_CLIENT_ID=

# Store builds (BUGSHOT_STORE_BUILD=1) use a different extension ID
VITE_GITHUB_CLIENT_ID_PROD=

# OAuth code→token exchange proxy. Keeps client secrets out of the bundle;
# relays the exchange only. Linear/GitLab use PKCE and skip it.
VITE_OAUTH_PROXY_URL=

# Anonymous analytics. Blank = disabled.
VITE_POSTHOG_KEY=
VITE_POSTHOG_KEY_PROD=
VITE_POSTHOG_HOST=
